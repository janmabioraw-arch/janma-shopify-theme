<div class="page-header">
  <div class="container">
    <p class="breadcrumbs"><a href="{{ routes.root_url }}">Home</a> / <span>{{ blog.title }}</span></p>
    <h1>{{ blog.title }}</h1>
  </div>
</div>

<section class="section">
  <div class="container">
    {% paginate blog.articles by 9 %}
      {% if blog.articles.size > 0 %}
        <div class="product-grid">
          {% for article in blog.articles %}
            <article class="product-card">
              <a href="{{ article.url }}" class="product-card__media">
                {% if article.image %}
                  {{ article.image | image_url: width: 600 | image_tag: alt: article.title, loading: 'lazy' }}
                {% else %}
                  <div style="width:100%;height:100%;background:linear-gradient(160deg,#F4DCD0,#F0E6D6);"></div>
                {% endif %}
              </a>
              <div class="product-card__body">
                <span class="product-card__category">{{ article.published_at | date: '%b %d, %Y' }}</span>
                <h3 class="product-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
                <p style="font-size:0.9rem;color:var(--color-text-muted);">{{ article.excerpt_or_content | strip_html | truncatewords: 18 }}</p>
                <a href="{{ article.url }}" class="product-card__cta">Read more</a>
              </div>
            </article>
          {% endfor %}
        </div>
      {% else %}
        <div class="empty-state">
          <h2>No journal entries yet</h2>
          <p>Stories from the Janma nest will appear here soon.</p>
        </div>
      {% endif %}

      {% if paginate.pages > 1 %}
        <nav class="text-center mt-6" style="display:flex; gap:10px; justify-content:center;">
          {% if paginate.previous %}<a class="btn btn--ghost btn--sm" href="{{ paginate.previous.url }}">← Previous</a>{% endif %}
          {% if paginate.next %}<a class="btn btn--ghost btn--sm" href="{{ paginate.next.url }}">Next →</a>{% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
