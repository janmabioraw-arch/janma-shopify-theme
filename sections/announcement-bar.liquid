{% if section.settings.text != blank %}
  <div class="announcement-bar">
    <div class="container">
      {% if section.settings.link != blank %}
        <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
      {% else %}
        <span>{{ section.settings.text }}</span>
      {% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Message", "default": "Free shipping on orders over Rs. 999  ·  Trusted by Indian paediatricians" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
