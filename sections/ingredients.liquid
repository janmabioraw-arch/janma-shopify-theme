    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hand-picked, single-source ingredients"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Each ingredient earns its place -- chosen for its origin, purity, and proven efficacy on the most sensitive skin."
    }
  ],
  "blocks": [
