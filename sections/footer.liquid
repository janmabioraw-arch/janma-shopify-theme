<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 200 | image_tag: alt: shop.name, loading: 'lazy' }}
        {% else %}
          <h3 style="font-family: var(--font-heading); color: var(--color-bg); font-size: 1.6rem; margin: 0 0 12px;">Janma</h3>
        {% endif %}
        <p>{{ section.settings.tagline | default: 'Born from a mother\'s instinct and a scientist\'s precision. Pure, plant-derived skincare for newborns, babies and juniors.' }}</p>
        <ul class="social-icons" style="margin-top:18px;">
          {% if section.settings.instagram_url != blank %}
            <li><a href="{{ section.settings.instagram_url }}" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.16c3.2 0 3.58 0 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85 0 3.2 0 3.58-.07 4.85-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.65.07-4.85.07-3.2 0-3.58 0-4.85-.07-3.26-.15-4.77-1.7-4.92-4.92C2.18 15.58 2.16 15.2 2.16 12s0-3.58.07-4.85C2.38 3.92 3.9 2.38 7.15 2.23 8.42 2.18 8.8 2.16 12 2.16zM12 0C8.74 0 8.33 0 7.05.07c-4.35.2-6.78 2.62-6.98 6.98C0 8.33 0 8.74 0 12s0 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98C8.33 24 8.74 24 12 24s3.67 0 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.68.07-4.95 0-3.26 0-3.67-.07-4.95-.2-4.35-2.62-6.78-6.98-6.98C15.67 0 15.26 0 12 0zm0 5.84A6.16 6.16 0 1 0 18.16 12 6.16 6.16 0 0 0 12 5.84zm0 10.16A4 4 0 1 1 16 12a4 4 0 0 1-4 4zm6.4-11.85a1.44 1.44 0 1 0 1.44 1.44 1.44 1.44 0 0 0-1.44-1.44z"/></svg>
            </a></li>
          {% endif %}
          {% if section.settings.facebook_url != blank %}
            <li><a href="{{ section.settings.facebook_url }}" aria-label="Facebook">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88V14.9H8v-2.9h2.44V9.84c0-2.41 1.43-3.74 3.62-3.74 1.05 0 2.15.19 2.15.19v2.36h-1.21c-1.19 0-1.56.74-1.56 1.5V12h2.66l-.43 2.9h-2.23v6.98A10 10 0 0 0 22 12z"/></svg>
            </a></li>
          {% endif %}
          {% if section.settings.youtube_url != blank %}
            <li><a href="{{ section.settings.youtube_url }}" aria-label="YouTube">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z"/></svg>
            </a></li>
          {% endif %}
          {% if section.settings.linkedin_url != blank %}
            <li><a href="{{ section.settings.linkedin_url }}" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zm1.78 13.02H3.56V9h3.56v11.45zM22.22 0H1.78A1.75 1.75 0 0 0 0 1.73v20.54A1.75 1.75 0 0 0 1.78 24h20.44A1.75 1.75 0 0 0 24 22.27V1.73A1.75 1.75 0 0 0 22.22 0z"/></svg>
            </a></li>
          {% endif %}
        </ul>
      </div>

      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'menu' %}
            <div {{ block.shopify_attributes }}>
              <h4>{{ block.settings.heading }}</h4>
              <ul>
                {% for link in block.settings.menu.links %}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {% endfor %}
              </ul>
            </div>
          {% when 'newsletter' %}
            <div class="site-footer__newsletter" {{ block.shopify_attributes }}>
              <h4>{{ block.settings.heading | default: 'Stay in our nest' }}</h4>
              <p style="color: rgba(251, 247, 242, 0.66); font-size: 0.9rem;">{{ block.settings.text | default: 'Get gentle guides for first-time parents, plus 10% off your first order.' }}</p>
              {% form 'customer' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <input type="email" name="contact[email]" placeholder="you@example.com" required>
                <button type="submit" class="btn btn--secondary btn--sm">Subscribe</button>
              {% endform %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    <div class="site-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. Crafted with care in India.</span>
      <ul style="display:flex; gap:18px; flex-wrap:wrap;">
        {% for policy in shop.policies %}
          {% if policy != blank %}
            <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "textarea", "id": "tagline", "label": "Brand tagline" },
    { "type": "header", "content": "Social links" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "url", "id": "youtube_url", "label": "YouTube URL" },
    { "type": "url", "id": "linkedin_url", "label": "LinkedIn URL" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in our nest" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop" } },
      { "type": "menu", "settings": { "heading": "About" } },
      { "type": "newsletter" }
    ]
  }
}
{% endschema %}
