{%- liquid
  assign product = product | default: card_product
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}
<article class="product-card" data-reveal>
  <a href="{{ product.url | within: collection }}" class="product-card__media">
    {% if product.featured_image != blank %}
      {{ product.featured_image | image_url: width: 600 | image_tag: alt: product.title, loading: 'lazy' }}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
    {% if on_sale %}<span class="product-card__badge">Save</span>{% endif %}
    {% if product.tags contains 'new' %}<span class="product-card__badge" style="left:auto; right:14px;">New</span>{% endif %}
  </a>
  <div class="product-card__body">
    {% if product.type != blank %}
      <span class="product-card__category">{{ product.type }}</span>
    {% endif %}
    <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <div class="product-card__price">
      {{ product.price | money }}
      {% if on_sale %}
        <span style="text-decoration:line-through; color:var(--color-text-muted); font-weight:400; margin-left:6px;">{{ product.compare_at_price | money }}</span>
      {% endif %}
      {% if product.selected_or_first_available_variant.unit_price_measurement %}
        <span class="product-card__price-unit">{{ product.selected_or_first_available_variant.unit_price | money }} / {{ product.selected_or_first_available_variant.unit_price_measurement.reference_value }}{{ product.selected_or_first_available_variant.unit_price_measurement.reference_unit }}</span>
      {% endif %}
    </div>
    <a href="{{ product.url }}" class="product-card__cta">View product</a>
  </div>
</article>
