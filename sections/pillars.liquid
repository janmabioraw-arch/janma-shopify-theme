<section class="section">
  <div class="container">
    <div class="section-heading" data-reveal>
      {% if section.settings.eyebrow != blank %}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
      <h2>{{ section.settings.heading | default: 'Pure care, in three promises' }}</h2>
    </div>
    <div class="pillars" data-reveal-stagger>
      {% for block in section.blocks %}
        <div class="pillar" {{ block.shopify_attributes }}>
          <div class="pillar__num">0{{ forloop.index }}</div>
          <h3 class="pillar__title">{{ block.settings.title }}</h3>
          <p class="pillar__desc">{{ block.settings.description }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pillars",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our promise"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pure care, in three promises"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pillars",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "title": "No-Tox",
            "description": "Free from parabens, sulphates, silicones, mineral oils, and synthetic colours."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Clinically Proven",
            "description": "Tested for sensitive skin, anti-inflammation, and acute irritation reduction."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Ayurvedically Crafted",
            "description": "Inspired by Charak Samhita and built around heritage botanicals."
          }
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "pillar",
        "settings": {
          "title": "No-Tox",
          "description": "Free from parabens, sulphates, silicones, mineral oils, and synthetic colours."
        }
      },
      {
        "type": "pillar",
        "settings": {
          "title": "Clinically Proven",
          "description": "Tested for sensitive skin, anti-inflammation, and acute irritation reduction."
        }
      },
      {
        "type": "pillar",
        "settings": {
          "title": "Ayurvedically Crafted",
          "description": "Inspired by Charak Samhita and built around heritage botanicals."
        }
      }
    ]
  }
}
{% endschema %}
