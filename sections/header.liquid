<header class="site-header">
  <div class="container site-header__inner">
    <nav class="site-header__nav" aria-label="Primary">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <button type="button" class="icon-btn mobile-toggle" data-mobile-toggle aria-label="Open menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 220 | image_tag: alt: shop.name, loading: 'eager', class: 'site-header__logo-img' }}
      {%- else -%}
        Janma
        <small>Born Pure · Made with Love</small>
      {%- endif -%}
    </a>

    <div class="site-header__actions">
      <a href="{{ routes.search_url }}" class="icon-btn" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3-3"/></svg>
        <span>Search</span>
      </a>
      <a href="{{ routes.account_url }}" class="icon-btn" aria-label="Account">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-7 8-7s8 3 8 7"/></svg>
        <span>Account</span>
      </a>
      <a href="{{ routes.cart_url }}" class="icon-btn" data-cart-toggle aria-label="Cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 7h12l-1.5 11.5a2 2 0 0 1-2 1.75H9.5a2 2 0 0 1-2-1.75L6 7zM9 7V5a3 3 0 0 1 6 0v2"/></svg>
        <span>Cart</span>
        <span class="cart-count" data-cart-count{% if cart.item_count == 0 %} style="display:none"{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <div class="mobile-nav" data-mobile-nav>
    <button type="button" class="icon-btn" data-mobile-toggle aria-label="Close menu" style="float:right">&times;</button>
    <ul>
      {%- for link in section.settings.menu.links -%}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {%- endfor -%}
    </ul>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
