<section class="section testimonials">
  <div class="container">
    <div class="section-heading" data-reveal>
      {% if section.settings.eyebrow != blank %}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
      <h2>{{ section.settings.heading | default: 'Loved by Indian parents' }}</h2>
    </div>
    <div class="testimonial-grid" data-reveal-stagger>
      {% for block in section.blocks %}
        <div class="testimonial" {{ block.shopify_attributes }}>
          <div class="testimonial__stars">{% assign rating = block.settings.rating | default: 5 %}{% for i in (1..rating) %}★{% endfor %}</div>
          <p class="testimonial__quote">"{{ block.settings.quote }}"</p>
          <p class="testimonial__author">-- {{ block.settings.author }}{% if block.settings.location != blank %}, {{ block.settings.location }}{% endif %}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Parent reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by Indian parents"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Stars"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
