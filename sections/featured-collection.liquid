<section class="section">
  <div class="container">
    <div class="section-heading" data-reveal>
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h2>{{ section.settings.heading | default: 'Bestselling rituals' }}</h2>
      {% if section.settings.subheading != blank %}
        <p>{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    {%- assign coll = section.settings.collection -%}
    {%- if coll != blank and coll.products.size > 0 -%}
      <div class="product-grid" data-reveal-stagger>
        {% for product in coll.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
    {%- else -%}
      <div class="product-grid" data-reveal-stagger>
        {%- for i in (1..4) -%}
          <article class="product-card">
            <div class="product-card__media">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="product-card__body">
              <span class="product-card__category">Baby Care</span>
              <h3 class="product-card__title">Sample product {{ i }}</h3>
              <div class="product-card__price">Rs. 698.00</div>
              <a href="#" class="product-card__cta">View product</a>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {% if section.settings.show_view_all %}
      <div class="text-center mt-6">
        <a href="{{ coll.url | default: '/collections/all' }}" class="btn btn--outline">Shop all products</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestselling rituals" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "From first baths to bedtime cuddles -- clinically gentle formulas trusted by Indian paediatricians." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "default": 6, "label": "Products" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' link", "default": true }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
