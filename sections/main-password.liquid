<section style="min-height: 80vh; display:flex; align-items:center; justify-content:center; background: linear-gradient(135deg, #F4DCD0 0%, #FBF7F2 100%); padding: 60px 20px;">
  <div style="max-width: 520px; text-align:center;">
    <span class="eyebrow">Coming soon</span>
    <h1 style="font-size: clamp(2rem, 5vw, 3.4rem); margin: 16px 0;">Janma is opening its doors</h1>
    <p>Born from love, crafted in care -- our new home for baby and junior skincare arrives shortly.</p>

    {% form 'storefront_password' %}
      {% if form.errors %}
        <p style="color: var(--color-terracotta-deep); margin-top: 16px;">{{ form.errors | default_errors }}</p>
      {% endif %}
      <div style="display:flex; gap:8px; max-width: 380px; margin: 24px auto 0; background: var(--color-bg); border-radius: var(--radius-pill); padding: 6px; box-shadow: var(--shadow-soft);">
        <input type="password" name="password" placeholder="Enter password" style="flex:1; border:none; background:transparent; padding: 12px 18px; outline:none;">
        <button type="submit" class="btn btn--primary">Enter</button>
      </div>
    {% endform %}

    <p style="margin-top: 28px; font-size:0.85rem;">Want to be first to know?</p>
    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="prelaunch">
      <div style="display:flex; gap:8px; max-width: 380px; margin: 8px auto 0;">
        <input type="email" name="contact[email]" placeholder="you@example.com" required style="flex:1; padding: 12px 18px; border: 1px solid var(--color-border); border-radius: var(--radius-pill);">
        <button type="submit" class="btn btn--outline">Notify me</button>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
