<div class="page-header">
  <div class="container">
    <h1>My account</h1>
    <p>Welcome back, {{ customer.first_name | default: customer.email }}.</p>
  </div>
</div>

<section class="container section">
  <div style="display:grid; grid-template-columns: 1fr 280px; gap:48px; align-items:start;">
    <div>
      <h2>Order history</h2>
      {% if customer.orders.size > 0 %}
        <div style="display:grid; gap:18px;">
          {% for order in customer.orders %}
            <a href="{{ order.customer_url }}" style="display:block; padding:22px; border:1px solid var(--color-border); border-radius:var(--radius-md); background:var(--color-surface);">
              <div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px;">
                <strong>{{ order.name }}</strong>
                <span>{{ order.created_at | date: '%B %d, %Y' }}</span>
              </div>
              <p style="margin:6px 0 0; font-size:0.9rem;">{{ order.financial_status }} · {{ order.fulfillment_status | default: 'Unfulfilled' }} · {{ order.total_price | money }}</p>
            </a>
          {% endfor %}
        </div>
      {% else %}
        <p>You haven't placed any orders yet.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary mt-4">Start shopping</a>
      {% endif %}
    </div>

    <aside style="position:sticky; top:100px;">
      <div style="padding:24px; background:var(--color-surface-warm); border-radius:var(--radius-md);">
        <h3 style="margin-top:0;">Account</h3>
        <ul style="display:grid; gap:8px;">
          <li><a href="{{ routes.account_addresses_url }}">Addresses ({{ customer.addresses_count }})</a></li>
          <li><a href="{{ routes.account_logout_url }}">Sign out</a></li>
        </ul>
      </div>
    </aside>
  </div>
</section>
